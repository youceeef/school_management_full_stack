{
  "name": "eduspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "front"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm --prefix front run dev -- --hostname 0.0.0.0",
    "build": "npm --prefix front run build",
    "start": "npm --prefix front run start -- --hostname 0.0.0.0",
    "lint": "npm --prefix front run lint",
    "test:i18n": "npm --prefix front run test:i18n",
    "test:system": "npm --prefix front run test:system",
    "test:version": "npm --prefix front run test:version",
    "test:unit": "npm --prefix front run test:unit",
    "smoke:production": "node scripts/verify-production.mjs"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}

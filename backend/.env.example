APP_NAME=EduSpace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SANCTUM_TOKEN_EXPIRATION=1440
APP_VERSION=local
APP_BUILD_TIME=
HEALTH_CACHE_SECONDS=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOADS_DISK=public
DOCUMENTS_DISK=local
QUEUE_CONNECTION=sync

CACHE_DRIVER=file
CACHE_PREFIX=

# Optional initial administrator. Set both values in production secrets.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production profile-image bucket (public)
PROFILE_AWS_ACCESS_KEY_ID=
PROFILE_AWS_SECRET_ACCESS_KEY=
PROFILE_AWS_DEFAULT_REGION=auto
PROFILE_AWS_BUCKET=
PROFILE_AWS_URL=
PROFILE_AWS_ENDPOINT=
PROFILE_AWS_USE_PATH_STYLE_ENDPOINT=false

# Production document bucket (private)
DOCUMENTS_AWS_ACCESS_KEY_ID=
DOCUMENTS_AWS_SECRET_ACCESS_KEY=
DOCUMENTS_AWS_DEFAULT_REGION=auto
DOCUMENTS_AWS_BUCKET=
DOCUMENTS_AWS_ENDPOINT=
DOCUMENTS_AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
